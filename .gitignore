.DS_Store
*.log
node_modules/

# Editor and agent-tooling state. This repo is cloned wholesale to instantiate
# a project, so local scratch must never ride along. These were previously in
# .git/info/exclude, which protects one machine and is not shared on clone.
.obsidian/
.impeccable/
.superpowers/

# Python bytecode. The orchestrator sets `sys.dont_write_bytecode`, so nothing
# it runs writes one — but an interpreter invoked by hand still can, and
# `gen-manifest.sh` hashes everything under `plugin/base/bin`.
__pycache__/
*.pyc

# Local ticket board for in-flight work on this machine; never ships.
tiqueteria/

# `langgraph dev`'s scratch server state, written beside langgraph.json.
.langgraph_api/
