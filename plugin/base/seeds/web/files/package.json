{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API (src/) and React web (web/).",
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && vite build web",
    "start": "node dist/main.js",
    "dev": "concurrently -n api,web \"tsx watch src/main.ts\" \"vite web\"",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p web/tsconfig.json && tsgo --noEmit -p web/test/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.16.22",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
