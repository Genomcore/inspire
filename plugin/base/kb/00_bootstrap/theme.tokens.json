{
  "color": {
    "$type": "color",
    "palette": {
      "white": { "$value": "#ffffff" },
      "slate-50": { "$value": "#f8fafc" },
      "slate-100": { "$value": "#f1f5f9" },
      "slate-200": { "$value": "#e2e8f0" },
      "slate-400": { "$value": "#94a3b8" },
      "slate-500": { "$value": "#64748b" },
      "slate-600": { "$value": "#475569" },
      "slate-700": { "$value": "#334155" },
      "slate-900": { "$value": "#0f172a" },
      "teal-600": { "$value": "#0d9488" },
      "teal-700": { "$value": "#0f766e" },
      "violet-50": { "$value": "#f5f3ff" },
      "violet-500": { "$value": "#8b5cf6" },
      "violet-700": { "$value": "#6d28d9" },
      "green-50": { "$value": "#f0fdf4" },
      "green-500": { "$value": "#22c55e" },
      "green-700": { "$value": "#15803d" },
      "blue-50": { "$value": "#eff6ff" },
      "blue-500": { "$value": "#3b82f6" },
      "blue-700": { "$value": "#1d4ed8" },
      "amber-50": { "$value": "#fffbeb" },
      "amber-500": { "$value": "#eab308" },
      "amber-700": { "$value": "#b45309" },
      "red-50": { "$value": "#fef2f2" },
      "red-500": { "$value": "#ef4444" },
      "red-700": { "$value": "#b91c1c" }
    },
    "background": { "$value": "{color.palette.white}", "$description": "The page ground." },
    "surface": { "$value": "{color.palette.slate-50}", "$description": "A recessed region: sidebars, toolbars, table headers." },
    "card": { "$value": "{color.palette.white}", "$description": "A card or panel ground." },
    "border": { "$value": "{color.palette.slate-200}", "$description": "Card edges and dividers." },
    "hover": { "$value": "{color.palette.slate-100}", "$description": "The ground of a hovered row or item." },
    "text": {
      "primary": { "$value": "{color.palette.slate-900}" },
      "secondary": { "$value": "{color.palette.slate-700}" },
      "tertiary": { "$value": "{color.palette.slate-500}" }
    },
    "primary": { "$value": "{color.palette.teal-600}", "$description": "Primary actions and the active state." },
    "primary-hover": { "$value": "{color.palette.teal-700}" },
    "accent": { "$value": "{color.palette.violet-500}", "$description": "The AI accent: assistants and agents." },
    "status": {
      "success": {
        "dot": { "$value": "{color.palette.green-500}" },
        "bg": { "$value": "{color.palette.green-50}" },
        "fg": { "$value": "{color.palette.green-700}" }
      },
      "progress": {
        "dot": { "$value": "{color.palette.blue-500}" },
        "bg": { "$value": "{color.palette.blue-50}" },
        "fg": { "$value": "{color.palette.blue-700}" }
      },
      "warning": {
        "dot": { "$value": "{color.palette.amber-500}" },
        "bg": { "$value": "{color.palette.amber-50}" },
        "fg": { "$value": "{color.palette.amber-700}" }
      },
      "danger": {
        "dot": { "$value": "{color.palette.red-500}" },
        "bg": { "$value": "{color.palette.red-50}" },
        "fg": { "$value": "{color.palette.red-700}" }
      },
      "idle": {
        "dot": { "$value": "{color.palette.slate-400}" },
        "bg": { "$value": "{color.palette.slate-100}" },
        "fg": { "$value": "{color.palette.slate-600}" }
      },
      "ai": {
        "dot": { "$value": "{color.palette.violet-500}" },
        "bg": { "$value": "{color.palette.violet-50}" },
        "fg": { "$value": "{color.palette.violet-700}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "xl": { "$value": "20px" }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "spacing": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": "6px" },
    "lg": { "$value": "8px" }
  },
  "size": {
    "$type": "dimension",
    "top-bar": { "$value": "56px" },
    "table-row": { "$value": "44px" },
    "sidebar-item": { "$value": "36px" }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" }
    },
    "stroke": { "$type": "number", "$value": 2 }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": "768px", "$description": "tablet" },
    "lg": { "$value": "1024px", "$description": "laptop" },
    "xl": { "$value": "1280px", "$description": "desktop" },
    "2xl": { "$value": "1536px", "$description": "wide" }
  },
  "viewport": {
    "$type": "dimension",
    "min": { "$value": "{breakpoint.md}", "$description": "The narrowest width the product must work at." }
  }
}
