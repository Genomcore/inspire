{
  "name": "inspire-graph",
  "version": "0.1.0",
  "description": "The visor's graph panel: nodes coloured by a content-index field, with a legend of the values on screen",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/graph"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "inspire-graph",
    "displayName": "INSPIRE graph",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.1.0 <6.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "localGraph": {
        "drag": true,
        "zoom": true,
        "depth": 1,
        "scale": 1.1,
        "repelForce": 0.5,
        "centerForce": 0.3,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": false,
        "enableRadial": false
      },
      "globalGraph": {
        "drag": true,
        "zoom": true,
        "depth": -1,
        "scale": 0.9,
        "repelForce": 0.5,
        "centerForce": 0.2,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": true,
        "enableRadial": true
      }
    },
    "components": {
      "Graph": {
        "displayName": "Graph",
        "defaultPosition": "right",
        "defaultPriority": 10
      }
    },
    "optionSchema": {
      "localGraph": {
        "type": "object"
      },
      "globalGraph": {
        "type": "object"
      }
    }
  }
}
