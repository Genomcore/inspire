{
  "exit": 0,
  "args": [
    "screen",
    "users.detail"
  ],
  "stdout_jq": [
    { "expr": ".route.default", "equals": "/users/detail/{id}" },
    { "expr": ".route.path | join(\",\")", "equals": "id" },
    { "expr": "[.claims[].id | select(contains(\"/param/\"))] | join(\",\")", "equals": "users.detail/param/id,users.detail/param/view" },
    { "expr": "[.claims[] | select(.id | contains(\"/param/\")) | .oracle] | unique | join(\",\")", "equals": "test" },
    { "expr": ".bindings.parameters[1].type.base", "equals": "enum" },
    { "expr": ".bindings.data[0].params | join(\",\")", "equals": "id" }
  ]
}
