{
  "schema": "inspire.derived-contract/1",
  "unit": {
    "kind": "action",
    "id": "auth.user.create",
    "path": "spec/sdd/auth/user/auth.user.create.md",
    "lifecycle": "draft",
    "module": "auth",
    "entity": "user",
    "action": "create"
  },
  "purpose": "Create a new platform user account from an email + password pair. The user-management subsystem is the source of truth for identity; this verb is its admin-side account-provisioning entry point. Identity model, scopes, and the auth-provider integration are defined in adr-auth-01-identity-model.",
  "requires": [
    {
      "kind": "action",
      "id": "auth.password.hash"
    },
    {
      "kind": "entity",
      "id": "auth.user"
    }
  ],
  "inputs": [
    {
      "name": "email",
      "type": {
        "name": "email",
        "base": "email"
      },
      "required": "yes",
      "description": "Account login email.",
      "constraints": []
    },
    {
      "name": "password",
      "type": {
        "name": "password",
        "base": "password"
      },
      "required": "yes",
      "description": "Plaintext password; hashed before write.",
      "constraints": [
        {
          "word": "len",
          "args": [
            "12",
            "128"
          ],
          "oracle": "test"
        }
      ]
    }
  ],
  "outputs": {
    "entity": null,
    "fields": [
      {
        "name": "id",
        "type": {
          "name": "uuid",
          "base": "uuid"
        },
        "description": "The newly created user id."
      }
    ]
  },
  "entities": [
    {
      "id": "auth.user",
      "as_input": "shape",
      "effect": "create",
      "fields": [
        {
          "field": "id",
          "touch": "written",
          "type": {
            "name": "uuid",
            "base": "uuid"
          },
          "mapping": "uuid()",
          "notes": "",
          "constraints": [
            {
              "word": "nonnull",
              "args": [],
              "oracle": "store"
            },
            {
              "word": "unique",
              "args": [],
              "oracle": "store"
            },
            {
              "word": "immutable",
              "args": [],
              "oracle": "test"
            }
          ]
        },
        {
          "field": "email",
          "touch": "written",
          "type": {
            "name": "email",
            "base": "email"
          },
          "mapping": "input.email",
          "notes": "",
          "constraints": [
            {
              "word": "nonnull",
              "args": [],
              "oracle": "store"
            },
            {
              "word": "pattern",
              "args": [
                "/.+@.+/"
              ],
              "oracle": "test"
            }
          ]
        },
        {
          "field": "created_at",
          "touch": "written",
          "type": {
            "name": "timestamp",
            "base": "timestamp"
          },
          "mapping": "now()",
          "notes": "",
          "constraints": [
            {
              "word": "nonnull",
              "args": [],
              "oracle": "store"
            },
            {
              "word": "immutable",
              "args": [],
              "oracle": "test"
            },
            {
              "word": "default",
              "args": [
                "now"
              ],
              "oracle": "store"
            }
          ]
        }
      ]
    }
  ],
  "preconditions": [
    {
      "key": "P1",
      "head": {
        "word": "actor",
        "args": [
          "admin"
        ]
      },
      "prose": "Only an administrator provisions accounts directly; the public path is [[auth.user.signup|auth::user::signup]].",
      "oracle": "test"
    },
    {
      "key": "P2",
      "head": {
        "word": "absent",
        "args": [
          "auth.user"
        ]
      },
      "prose": "No account may already hold the submitted email, per the identity model in [[adr-auth-01-identity-model]].",
      "oracle": "test"
    }
  ],
  "behavior": [
    {
      "key": "B1",
      "head": null,
      "prose": "Validate the email format against the rules described in [[auth-user-management#email-constraints|the user-management email rules]].",
      "oracle": "test"
    },
    {
      "key": "B2",
      "head": null,
      "prose": "Hash the password using [[auth.password.hash|auth::password::hash]], following the auth-provider integration model in [[adr-auth-01-identity-model]].",
      "oracle": "test"
    },
    {
      "key": "B3",
      "head": null,
      "prose": "Persist a new user row with the hashed credential.",
      "oracle": "test"
    }
  ],
  "postconditions": [
    {
      "key": "Q1",
      "head": {
        "word": "created",
        "args": [
          "auth.user"
        ]
      },
      "prose": "Exactly one row exists for the submitted email.",
      "oracle": "test"
    },
    {
      "key": "Q2",
      "head": {
        "word": "returns",
        "args": [
          "id"
        ]
      },
      "prose": "The caller receives the new row's identifier.",
      "oracle": "test"
    }
  ],
  "errors": [
    {
      "key": "email_exists",
      "head": {
        "word": "unique",
        "args": [
          "email"
        ]
      },
      "prose": "operator-facing message: \"An account already exists with that email.\"",
      "oracle": "store"
    }
  ],
  "claims": [
    {
      "id": "auth.user.create/input/password/len",
      "oracle": "test",
      "fingerprint": "sha256:71fb5be48b1db07c7a2ad183262d43e11cffd00b541f325117f2f6522f9103ca"
    },
    {
      "id": "auth.user.create/pre/P1",
      "oracle": "test",
      "fingerprint": "sha256:90cfa33b7e6d503f6959ab320221e718aa186f83c4782f9edbb96f77ba30b2d9"
    },
    {
      "id": "auth.user.create/pre/P2",
      "oracle": "test",
      "fingerprint": "sha256:103e95d365d3cbb953a5102051d60e35282695c375506736079df8127cc55a0d"
    },
    {
      "id": "auth.user.create/step/B1",
      "oracle": "test",
      "fingerprint": "sha256:16506b69835fac747db22f6af74296d342356d372ac0c95413d8b9d2b6e87130"
    },
    {
      "id": "auth.user.create/step/B2",
      "oracle": "test",
      "fingerprint": "sha256:acc1e1ba51fb46a46c52db2ca4fca01f5284b182773e3c3021108c43a32f56c0"
    },
    {
      "id": "auth.user.create/step/B3",
      "oracle": "test",
      "fingerprint": "sha256:843a8e6d0a8b741f712bb32ff4a8510cc32c2d756c00c3c22d5b684e7fb3246e"
    },
    {
      "id": "auth.user.create/post/Q1",
      "oracle": "test",
      "fingerprint": "sha256:f4684bc8abb6962282f78217fe05f3be8637b10b0ac07918ee882970a71374b0"
    },
    {
      "id": "auth.user.create/post/Q2",
      "oracle": "test",
      "fingerprint": "sha256:e93e0ed78d8d1e7d484997fdc8701791b4ede358d064220454ac5451c1839a27"
    },
    {
      "id": "auth.user.create/error/email_exists",
      "oracle": "store",
      "fingerprint": "sha256:435e76d08014c8484fba245dad5ef483f303b983be25a3dc338f534dc9512482"
    }
  ]
}
