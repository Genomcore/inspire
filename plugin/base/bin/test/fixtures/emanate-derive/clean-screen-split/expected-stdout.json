{
  "schema": "inspire.derived-contract/1",
  "unit": {
    "kind": "screen",
    "id": "users.list",
    "path": "spec/kb/05_screens/portal/users/list.md",
    "lifecycle": "accepted",
    "module": "users",
    "screen": "list"
  },
  "purpose": "An administrator comes here to find one account among many. The roster leads, so the reader sees who exists before choosing anyone to act on.",
  "requires": [
    {
      "kind": "action",
      "id": "auth.user.create"
    },
    {
      "kind": "action",
      "id": "auth.user.get"
    },
    {
      "kind": "component",
      "id": "data-table"
    },
    {
      "kind": "pattern",
      "id": "list"
    },
    {
      "kind": "screen",
      "id": "users.detail"
    }
  ],
  "features": [
    "FEAT-01",
    "FEAT-02"
  ],
  "pattern": {
    "id": "list",
    "path": "spec/kb/05_screens/patterns/list.md"
  },
  "components": [
    {
      "id": "data-table",
      "path": "spec/kb/05_screens/components/data-table.md",
      "state": "implemented"
    }
  ],
  "bindings": {
    "data": [
      {
        "key": "main",
        "action": "auth.user.get",
        "notes": "the primary table feed"
      }
    ],
    "dispatches": [
      {
        "key": "create",
        "action": "auth.user.create",
        "trigger": "primary action",
        "on_success": "nav:users.detail",
        "on_error": "state:form-error"
      }
    ],
    "navigation": [
      {
        "key": "row",
        "target": "users.detail",
        "trigger": "clicking a row"
      }
    ],
    "states": [
      {
        "key": "empty",
        "when": "`main` returns zero rows",
        "presentation": "the empty-collection message"
      },
      {
        "key": "form-error",
        "when": "`create` rejects",
        "presentation": "the field errors, inline"
      }
    ]
  },
  "route": {
    "module": "users",
    "screen": "list",
    "default": "/users/list"
  },
  "claims": [
