{
  "schema": "inspire.derived-contract/1",
  "unit": {
    "kind": "entity",
    "id": "auth.user",
    "path": "spec/sdd/auth/user/auth.user.md",
    "lifecycle": "accepted",
    "module": "auth",
    "entity": "user"
  },
  "purpose": "The account record a principal signs in with, described in auth-user-management.",
  "requires": [
    {
      "kind": "entity",
      "id": "auth.org"
    }
  ],
  "fields": [
    {
      "name": "id",
      "type": {
        "name": "uuid",
        "base": "uuid"
      },
      "notes": "Primary key.",
      "constraints": [
        {
          "word": "nonnull",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "unique",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "immutable",
          "args": [],
          "oracle": "test"
        }
      ]
    },
    {
      "name": "org_id",
      "type": {
        "name": "uuid",
        "base": "uuid"
      },
      "notes": "The owning organisation.",
      "constraints": [
        {
          "word": "nonnull",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "immutable",
          "args": [],
          "oracle": "test"
        },
        {
          "word": "references",
          "args": [
            "auth.org"
          ],
          "oracle": "store"
        }
      ]
    },
    {
      "name": "email",
      "type": {
        "name": "email",
        "base": "email"
      },
      "notes": "Unique across rows.",
      "constraints": [
        {
          "word": "nonnull",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "pattern",
          "args": [
            "/^[a-z]{3,8}@.+$/"
          ],
          "oracle": "test"
        }
      ]
    },
    {
      "name": "status",
      "type": {
        "name": "status",
        "base": "string"
      },
      "notes": "Where the account sits.",
      "constraints": [
        {
          "word": "nonnull",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "default",
          "args": [
            "active"
          ],
          "oracle": "store"
        }
      ]
    },
    {
      "name": "created_at",
      "type": {
        "name": "timestamp",
        "base": "timestamp"
      },
      "notes": "The audit-timeline anchor.",
      "constraints": [
        {
          "word": "nonnull",
          "args": [],
          "oracle": "store"
        },
        {
          "word": "immutable",
          "args": [],
          "oracle": "test"
        },
        {
          "word": "default",
          "args": [
            "now"
          ],
          "oracle": "store"
        }
      ]
    }
  ],
  "invariants": [
    {
      "key": "I1",
      "head": {
        "word": "unique",
        "args": [
          "org_id",
          "email"
        ]
      },
      "prose": "Email is unique per organisation, never globally.",
      "oracle": "store"
    },
    {
      "key": "I2",
      "head": null,
      "prose": "A suspended account keeps every row it wrote; suspension changes what may be read.",
      "oracle": "test"
    }
  ],
