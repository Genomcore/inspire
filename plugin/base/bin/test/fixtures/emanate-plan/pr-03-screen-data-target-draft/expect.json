  "args": [
    "--profiles-root",
    "spec/profiles",
    "--agents-root",
    "spec/agents"
  ],
  "stdout_jq": [
    { "expr": "[.findings[].code] | unique | join(\",\")", "equals": "PR-03" },
    { "expr": "[.findings[].severity] | unique | join(\",\")", "equals": "error" },
