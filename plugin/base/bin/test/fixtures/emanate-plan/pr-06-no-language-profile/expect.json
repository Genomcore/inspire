{
  "exit": 1,
  "args": [
    "--skills-root",
    "spec/skills",
    "--agents-root",
    "spec/agents"
  ],
  "stdout_jq": [
    { "expr": "[.findings[].code] | unique | join(\",\")", "equals": "PR-06" },
    { "expr": ".findings[0].target", "equals": "spec/skills/typescript/SKILL.md" },
    { "expr": ".findings[0].owner", "equals": "inspire-bootstrap" },
    { "expr": ".findings[0].remedy", "equals": "add spec/skills/typescript/SKILL.md, or point `nestjs`'s `language:` at a `layer: language` profile that exists" },
    { "expr": ".units[0].profiles | join(\",\")", "equals": "nestjs" },
    { "expr": ".ready", "equals": "false" }
  ]
}
