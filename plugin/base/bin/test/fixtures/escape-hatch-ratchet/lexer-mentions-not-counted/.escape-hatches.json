{
  "scope": ["src"],
  "extensions": ["ts"],
  "lexicon": {
    "line_comments": ["//"],
    "block_comments": [{ "open": "/*", "close": "*/" }],
    "strings": [
      { "open": "\"", "close": "\"", "escape": "\\" },
      { "open": "'", "close": "'", "escape": "\\" },
      { "open": "`", "close": "`", "escape": "\\", "multiline": true,
        "interpolation": { "open": "${", "close": "}" } }
    ]
  },
  "patterns": [
    { "id": "as-any", "in": "code", "regex": "as any", "ceiling": 0 },
    { "id": "ts-expect-error", "in": "comment", "regex": "@ts-expect-error", "ceiling": 0 }
  ]
}
