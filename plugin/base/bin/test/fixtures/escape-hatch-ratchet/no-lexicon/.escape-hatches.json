{
  "scope": [
    "src"
  ],
  "extensions": [
    "ts"
  ],
  "patterns": [
    {
      "id": "as-any",
      "in": "code",
      "regex": "as any",
      "ceiling": 0
    },
    {
      "id": "ts-expect-error",
      "in": "comment",
      "regex": "@ts-expect-error",
      "ceiling": 0
    }
  ]
}
