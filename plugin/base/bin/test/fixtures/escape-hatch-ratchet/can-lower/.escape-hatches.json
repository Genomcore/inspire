{
  "scope": [
    "src"
  ],
  "extensions": [
    "ts"
  ],
  "patterns": [
    {
      "id": "as-any",
      "in": "code",
      "regex": "as any",
      "ceiling": 5
    }
  ],
  "lexicon": {
    "line_comments": [
      "//"
    ],
    "block_comments": [
      {
        "open": "/*",
        "close": "*/"
      }
    ],
    "strings": [
      {
        "open": "\"",
        "close": "\"",
        "escape": "\\"
      },
      {
        "open": "'",
        "close": "'",
        "escape": "\\"
      },
      {
        "open": "`",
        "close": "`",
        "escape": "\\",
        "multiline": true,
        "interpolation": {
          "open": "${",
          "close": "}"
        }
      }
    ]
  }
}
